{
    "name": "lidpractice",
    "version": "1.0.0",
    "description": "Trainer for the Leben in Deutschland test and the Einbürgerungstest (all 460 questions of the official catalogue)",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
        "lint": "eslint .",
        "catalogue:verify": "node scripts/verify-catalogue.mjs",
        "catalogue:images": "node scripts/extract-catalogue-pages.mjs --update-data",
        "catalogue:pictures": "node scripts/extract-question-pictures.mjs",
        "assets:icons": "node scripts/generate-icons.mjs",
        "assets:fonts": "node scripts/vendor-fonts.mjs",
        "catalogue:drift": "node scripts/check-catalogue-drift.mjs",
        "build": "tsc --noEmit && node build.mjs",
        "serve": "http-server dist -p 8080 -c-1",
        "clean": "node -e \"for(const d of ['dist','coverage','test-results','playwright-report'])require('fs').rmSync(d,{recursive:true,force:true})\"",
        "test:unit": "vitest run --coverage",
        "test:unit:watch": "vitest",
        "test:e2e": "playwright test",
        "test": "npm run lint && npm run typecheck && npm run clean && npm run build && npm run test:unit && npm run test:e2e"
    },
    "keywords": [],
    "author": "Harsh Ankur",
    "license": "PolyForm-Noncommercial-1.0.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/harshankur/lidpractice.git"
    },
    "private": true,
    "engines": {
        "node": ">=20"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@fontsource-variable/bricolage-grotesque": "^5.3.0",
        "@fontsource-variable/noto-sans": "^5.3.0",
        "@fontsource-variable/public-sans": "^5.3.0",
        "@fontsource/noto-sans-arabic": "^5.3.0",
        "@fontsource/noto-sans-devanagari": "^5.3.0",
        "@playwright/test": "^1.64.0",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^26.6.4",
        "@vitest/coverage-v8": "^5.0.3",
        "esbuild": "^0.28.2",
        "eslint": "^10.12.0",
        "fast-check": "^4.10.2",
        "globals": "^17.13.0",
        "http-server": "^14.1.1",
        "jsdom": "^30.1.2",
        "sharp": "^0.35.5",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.1",
        "vitest": "^5.0.3",
        "yaml": "^2.9.1"
    }
}
